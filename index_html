<!doctype html>
<html lang="it">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Dott. Luca Merli — Fisioterapista</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Newsreader:opsz,wght@6..72,300;6..72,400&display=swap');
:root{
  --ivory:#f5f1e8; --ivory2:#faf8f2; --sage:#a8b09a; --sage-dark:#59644f;
  --ink:#171a16; --line:rgba(23,26,22,.14);
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;background:var(--ivory);color:var(--ink);font-family:"DM Sans",Arial,sans-serif}
a{color:inherit;text-decoration:none}
header{
  height:72px;position:fixed;z-index:40;top:0;left:0;right:0;
  display:flex;align-items:center;justify-content:space-between;padding:0 6vw;
  background:rgba(245,241,232,.92);backdrop-filter:blur(14px);border-bottom:1px solid var(--line)
}
.brand{font-size:12px;font-weight:600;letter-spacing:.11em;text-transform:uppercase}
nav{display:flex;gap:30px;font-size:10px;letter-spacing:.16em;text-transform:uppercase}
.burger{display:none;border:0;background:none;font-size:25px;color:var(--ink)}
main{overflow:hidden}
.wrap{width:min(86vw,1380px);margin:auto}
.eyebrow{font-size:10px;font-weight:600;letter-spacing:.19em;text-transform:uppercase;margin-bottom:20px}
h1,h2,h3{font-family:"Newsreader",Georgia,serif;font-weight:300;margin:0}
p{margin:0;line-height:1.65}
.hero{min-height:100vh;padding:150px 0 85px;display:flex;align-items:center;position:relative}
.hero-grid{display:grid;grid-template-columns:1.12fr .62fr;gap:8vw;align-items:end;width:100%}
.hero h1{font-size:clamp(76px,10vw,158px);line-height:.83;letter-spacing:-.055em;max-width:950px}
.hero h1 em{font-style:normal;color:var(--sage-dark)}
.hero-copy{padding-bottom:14px;max-width:390px}
.hero-copy p{font-size:17px;margin-bottom:30px}
.cta{display:inline-flex;align-items:center;gap:28px;padding:15px 20px;border:1px solid var(--ink);font-size:10px;letter-spacing:.15em;text-transform:uppercase;transition:.3s}
.cta:hover{background:var(--ink);color:var(--ivory)}
.anatomy{position:absolute;right:-2vw;top:105px;width:34vw;height:62vh;opacity:.15;pointer-events:none}
.anatomy svg{width:100%;height:100%}
.section{padding:125px 0;border-top:1px solid var(--line)}
.bio{background:var(--ivory2)}
.bio-grid{display:grid;grid-template-columns:.72fr 1.25fr;gap:9vw;align-items:center}
.portrait{width:100%;max-width:430px;aspect-ratio:4/5;object-fit:cover;object-position:center 28%;display:block}
.bio h2,.approach h2,.areas h2,.contact h2{font-size:clamp(52px,6.2vw,96px);line-height:.94;letter-spacing:-.04em}
.bio .role{font-size:18px;color:var(--sage-dark);margin:14px 0 30px}
.bio .lead{max-width:690px;font-size:16px}
.tags{display:flex;gap:10px;flex-wrap:wrap;margin-top:32px}
.tag{padding:10px 17px;border:1px solid var(--sage);border-radius:99px;font-size:12px;color:var(--sage-dark)}
.approach{background:var(--sage)}
.approach-grid{display:grid;grid-template-columns:1fr .9fr;gap:10vw;align-items:center}
.approach h2{max-width:700px}
.approach-copy{max-width:550px}
.approach-copy p{font-size:17px}
.steps{margin-top:34px;border-top:1px solid rgba(23,26,22,.18)}
.step{display:grid;grid-template-columns:45px 1fr;padding:16px 0;border-bottom:1px solid rgba(23,26,22,.18);font-size:13px}
.motion-mark{height:250px;margin-top:45px;position:relative}
.motion-mark svg{width:100%;height:100%;opacity:.65}
.areas{background:var(--ivory2)}
.areas-head{display:grid;grid-template-columns:1.15fr .7fr;gap:8vw;align-items:end;margin-bottom:70px}
.areas-head p{max-width:470px}
.area-grid{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid var(--line)}
.area{padding:45px 35px 10px 0;min-height:360px;border-right:1px solid var(--line)}
.area+.area{padding-left:35px}
.area:last-child{border-right:0}
.area-icon{height:130px;margin-bottom:34px;color:var(--sage-dark)}
.area-icon svg{height:100%;width:auto;max-width:100%}
.area h3{font-size:38px;margin-bottom:13px}
.area p{font-size:14px;max-width:330px}
.contact{background:var(--ivory);padding:110px 0}
.contact-grid{display:grid;grid-template-columns:1fr .75fr;gap:10vw;align-items:end}
.contact p{max-width:440px;margin:18px 0 28px}
.contact-actions{display:flex;gap:12px;flex-wrap:wrap}
.cta.sage{background:var(--sage-dark);border-color:var(--sage-dark);color:var(--ivory2)}
.cta.sage:hover{background:var(--ink);border-color:var(--ink)}
.phone-note{margin-top:16px!important;font-size:13px;color:var(--sage-dark)}
footer{padding:25px 6vw;border-top:1px solid var(--line);display:flex;justify-content:space-between;font-size:10px;letter-spacing:.12em;text-transform:uppercase}
.reveal{opacity:0;transform:translateY(32px);transition:opacity .8s ease,transform .8s ease}
.reveal.on{opacity:1;transform:none}
.mobile-menu{display:none}
@media(max-width:760px){
 header{height:64px;padding:0 22px}.desktop-nav{display:none}.burger{display:block}
 .mobile-menu{display:flex;position:fixed;z-index:35;inset:64px 0 0;background:var(--ivory);flex-direction:column;padding:55px 25px;gap:30px;transform:translateX(100%);transition:.35s}
 .mobile-menu.open{transform:none}.mobile-menu a{font-family:"Newsreader";font-size:42px}
 .wrap{width:calc(100% - 44px)}
 .hero{min-height:92vh;padding:125px 0 70px}.hero-grid,.bio-grid,.approach-grid,.areas-head,.contact-grid{grid-template-columns:1fr;gap:45px}
 .hero h1{font-size:clamp(62px,18vw,92px)}.hero-copy{max-width:100%}.anatomy{width:75vw;height:48vh;right:-28vw;top:90px}
 .section{padding:85px 0}.portrait{max-width:100%;aspect-ratio:4/4.8}.bio h2,.approach h2,.areas h2,.contact h2{font-size:58px}
 .area-grid{grid-template-columns:1fr}.area,.area+.area{padding:38px 0;border-right:0;border-bottom:1px solid var(--line);min-height:0}
 .area-icon{height:100px}.contact{padding:85px 0}footer{padding:22px;gap:20px;flex-direction:column}
}
</style>
</head>
<body>
<header>
  <a class="brand" href="#home">Luca Merli</a>
  <nav class="desktop-nav"><a href="#luca">Chi sono</a><a href="#approccio">Approccio</a><a href="#aree">Aree</a><a href="#contatti">Contatti</a></nav>
  <button class="burger" aria-label="Apri menu">☰</button>
</header>
<nav class="mobile-menu"><a href="#luca">Chi sono</a><a href="#approccio">Approccio</a><a href="#aree">Aree</a><a href="#contatti">Contatti</a></nav>

<main id="home">
<section class="hero">
 <div class="anatomy" aria-hidden="true">
  <svg viewBox="0 0 500 700" fill="none" stroke="currentColor" stroke-width="1.25">
   <path d="M300 35c-35 44-47 86-39 126 8 41 27 62 22 101-6 48-43 81-44 129-2 60 48 89 41 148-5 42-33 78-25 123"/>
   <path d="M274 72c19 4 37 4 55-2M267 99c22 6 44 6 66 0M264 128c25 7 49 7 73 0M267 158c25 8 48 8 71 1M274 190c22 8 43 8 63 1M278 222c20 8 39 8 57 2M276 255c19 7 37 7 55 2M267 289c20 7 39 7 58 1M253 326c22 8 44 8 66 0M245 366c24 9 48 9 72 0M247 407c25 9 50 9 75 0M258 449c24 8 48 8 72 0M270 490c22 7 43 7 64 0M276 531c20 6 39 6 58 0"/>
   <circle cx="302" cy="72" r="7"/><circle cx="299" cy="101" r="7"/><circle cx="300" cy="131" r="7"/><circle cx="303" cy="161" r="7"/><circle cx="305" cy="193" r="7"/><circle cx="304" cy="225" r="7"/><circle cx="301" cy="258" r="7"/><circle cx="295" cy="292" r="7"/><circle cx="284" cy="330" r="7"/><circle cx="280" cy="370" r="7"/><circle cx="284" cy="411" r="7"/><circle cx="294" cy="453" r="7"/><circle cx="304" cy="493" r="7"/><circle cx="309" cy="534" r="7"/>
   <path d="M210 128c-58 23-94 67-108 131M337 129c52 28 84 71 96 128" opacity=".55"/>
  </svg>
 </div>
 <div class="wrap hero-grid">
  <div class="reveal">
   <div class="eyebrow">Dott. Luca Merli · Fisioterapista</div>
   <h1>Il movimento<br>è parte <em>della cura.</em></h1>
  </div>
  <div class="hero-copy reveal">
   <p>Terapia manuale, esercizio ed educazione per un percorso riabilitativo attivo e consapevole.</p>
   <a class="cta" href="#contatti">Prenota una visita <span>→</span></a>
  </div>
 </div>
</section>

<section class="section bio" id="luca">
 <div class="wrap bio-grid">
  <img class="portrait reveal" src="data:image/jpeg;base64," alt="Dott. Luca Merli">
  <div class="reveal">
   <div class="eyebrow">Chi sono</div>
   <h2>Dott. Luca Merli</h2>
   <div class="role">Terapia manuale · Spalla e colonna</div>
   <p class="lead">Laureato con lode in Fisioterapia all'Università La Sapienza di Roma. Nel 2024 consegue il Master in Terapia Manuale all'Università di Genova, specializzandosi nei disturbi della spalla e della colonna vertebrale. Esperto di capsulite adesiva e di disturbi persistenti di cervicale e lombare, dedica grande attenzione all'educazione del paziente nella gestione delle proprie patologie.</p>
   <div class="tags"><span class="tag">Spalla</span><span class="tag">Colonna vertebrale</span><span class="tag">Capsulite</span></div>
  </div>
 </div>
</section>

<section class="section approach" id="approccio">
 <div class="wrap approach-grid">
  <div class="reveal">
   <div class="eyebrow">Approccio</div>
   <h2>Un percorso attivo,<br>costruito su di te.</h2>
   <div class="motion-mark">
    <svg viewBox="0 0 650 230" fill="none" stroke="#171a16" stroke-width="1.4">
     <path d="M25 168c90-8 112-117 203-112 81 5 85 112 166 115 85 4 111-89 226-104"/>
     <path d="M34 188c88-7 116-83 192-81 78 2 96 82 169 84 85 2 122-66 216-72" opacity=".35"/>
     <circle cx="228" cy="56" r="7" fill="#171a16"/><circle cx="394" cy="171" r="7" fill="#171a16"/>
    </svg>
   </div>
  </div>
  <div class="approach-copy reveal">
   <p>Il trattamento non si limita alla terapia manuale. Il movimento viene utilizzato come parte attiva della riabilitazione, con esercizi progressivi e indicazioni personalizzate per favorire una gestione più consapevole del percorso.</p>
   <div class="steps">
    <div class="step"><span>01</span><span>Valutazione del problema e degli obiettivi.</span></div>
    <div class="step"><span>02</span><span>Terapia manuale ed esercizio attivo.</span></div>
    <div class="step"><span>03</span><span>Progressione del movimento ed educazione del paziente.</span></div>
   </div>
  </div>
 </div>
</section>

<section class="section areas" id="aree">
 <div class="wrap">
  <div class="areas-head reveal">
   <div><div class="eyebrow">Aree di intervento</div><h2>Spalla, colonna,<br>capsulite.</h2></div>
   <p>Un percorso costruito sulla valutazione individuale, integrando terapia manuale, movimento ed educazione.</p>
  </div>
  <div class="area-grid">
   <article class="area reveal"><div class="area-icon">
    <svg viewBox="0 0 180 130" fill="none" stroke="currentColor" stroke-width="1.4"><circle cx="94" cy="56" r="24"/><path d="M92 31c-18-20-45-20-61-2M70 54C43 56 25 73 20 105M113 54c28 5 42 22 46 49M90 80c-4 17-1 30 8 42M110 78c12 14 20 29 23 44"/><path d="M56 27c8 9 17 15 29 18"/></svg>
   </div><h3>Spalla</h3><p>Valutazione e gestione dei disturbi della spalla e delle limitazioni di movimento.</p></article>
   <article class="area reveal"><div class="area-icon">
    <svg viewBox="0 0 180 130" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M94 5c-12 15-14 29-6 42 9 14 9 26 1 39-8 14-7 27 5 39"/><path d="M79 20h29M77 34h33M81 49h29M82 65h27M79 81h31M80 98h31M86 114h25"/><circle cx="94" cy="20" r="4"/><circle cx="94" cy="35" r="4"/><circle cx="95" cy="50" r="4"/><circle cx="95" cy="66" r="4"/><circle cx="95" cy="82" r="4"/><circle cx="96" cy="99" r="4"/></svg>
   </div><h3>Colonna vertebrale</h3><p>Disturbi persistenti cervicali e lombari, con attenzione al recupero del movimento e alla gestione quotidiana.</p></article>
   <article class="area reveal"><div class="area-icon">
    <svg viewBox="0 0 180 130" fill="none" stroke="currentColor" stroke-width="1.4"><circle cx="94" cy="56" r="24"/><path d="M92 31c-18-20-45-20-61-2M70 54C43 56 25 73 20 105M113 54c28 5 42 22 46 49M90 80c-4 17-1 30 8 42M110 78c12 14 20 29 23 44"/><path d="M56 27c8 9 17 15 29 18"/><path d="M74 36c12-10 29-11 42-2" stroke-dasharray="3 4"/></svg>
   </div><h3>Capsulite</h3><p>Percorsi progressivi e personalizzati dedicati alla capsulite adesiva.</p></article>
  </div>
 </div>
</section>

<section class="contact" id="contatti">
 <div class="wrap contact-grid reveal">
  <div><div class="eyebrow">Contatti</div><h2>Prenota una visita.</h2></div>
  <div>
    <p>Per informazioni o per fissare un appuntamento puoi contattarmi direttamente.</p>
    <div class="contact-actions">
      <a class="cta sage" href="tel:+393319216207" aria-label="Chiama il Dottor Luca Merli al numero +39 331 9216207">Chiama ora <span>→</span></a>
    </div>
    <p class="phone-note">+39 331 9216207</p>
  </div>
 </div>
</section>
</main>
<footer><span>© Luca Merli</span><span>Fisioterapista · Terapia manuale</span></footer>

<script>
const io=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting)e.target.classList.add('on')}),{threshold:.13});
document.querySelectorAll('.reveal').forEach(el=>io.observe(el));
const burger=document.querySelector('.burger'), menu=document.querySelector('.mobile-menu');
burger.addEventListener('click',()=>{menu.classList.toggle('open');burger.textContent=menu.classList.contains('open')?'×':'☰'});
menu.querySelectorAll('a').forEach(a=>a.addEventListener('click',()=>{menu.classList.remove('open');burger.textContent='☰'}));
</script>
</body></html>
